{
	"name": "@atom-forge/ui",
	"version": "0.1.0",
	"style": "./core/theme.css",
	"author": {
		"name": "Gergely Laborci",
		"url": "https://github.com/laborci"
	},
	"description": "A Svelte component library for building admin interfaces and dashboards",
	"license": "SEE LICENSE IN LICENSE",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"prepack": "svelte-kit sync && svelte-package && publint",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"package": "svelte-package",
		"prepublishOnly": "npm run prepack",
		"pub-check": "ship-it check",
		"pub": "ship-it",
		"check:showcase": "bun run package && node scripts/showcase/migration-check.mjs && node scripts/showcase/audit.mjs",
		"deploy": "python3 deploy/local.py"
	},
	"ship": {
		"verify": [
			"bun run check",
			"bun run check:showcase",
			"bunx publint"
		],
		"after": [
			"ship-it check --wait 900",
			"bun run deploy"
		]
	},
	"repository": {
		"url": "git://github.com/atom-forge/ui.git"
	},
	"files": [
		"dist",
		"!dist/**/*.test.*",
		"!dist/**/*.spec.*",
		"docs",
		"README.md",
		"README-AI.md",
		"LICENSE",
		"CHANGELOG.md"
	],
	"sideEffects": [
		"**/*.css"
	],
	"svelte": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"svelte": "./dist/index.js",
			"default": "./dist/index.js"
		},
		"./theme.css": {
			"import": "./dist/core/theme.css",
			"style": "./dist/core/theme.css",
			"default": "./dist/core/theme.css"
		}
	},
	"peerDependencies": {
		"@sveltejs/kit": "^2.0.0",
		"svelte": "^5.0.0"
	},
	"devDependencies": {
		"@atom-forge/ship": "0.3.0",
		"@sveltejs/adapter-static": "^4.0.0",
		"@sveltejs/kit": "^2.49.1",
		"@sveltejs/package": "^2.5.7",
		"@sveltejs/vite-plugin-svelte": "^6.2.1",
		"@tailwindcss/forms": "^0.5.10",
		"@tailwindcss/typography": "^0.5.20",
		"@tailwindcss/vite": "^4.1.17",
		"publint": "^0.3.15",
		"svelte": "^5.45.6",
		"svelte-check": "^4.3.4",
		"svelte-language-server": "^0.17.29",
		"tailwindcss": "^4.1.17",
		"typescript": "^5.9.3",
		"vite": "^7.2.6"
	},
	"keywords": [
		"svelte"
	],
	"dependencies": {
		"@atlaskit/pragmatic-drag-and-drop": "^1.7.9",
		"@atom-forge/svelte-helpers": "^0.0.4",
		"chart.js": "^4.5.1",
		"esm-env": "^1.2.2",
		"lucide-svelte": "^0.561.0",
		"marked": "^17.0.4",
		"svelte-dnd-action": "^0.9.70",
		"svelte-highlight": "^7.9.0",
		"tailwind-merge": "^3.4.0"
	}
}

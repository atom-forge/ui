{
	"extends": "./.svelte-kit/tsconfig.json",
	"compilerOptions": {
		"rewriteRelativeImportExtensions": true,
		"allowJs": true,
		"checkJs": true,
		"forceConsistentCasingInFileNames": true,
		"resolveJsonModule": true,
		"skipLibCheck": true,
		"sourceMap": true,
		"strict": true,
		"module": "NodeNext",
		"noImplicitAny": false,
		"paths": {
			"$lib": [
				"../_/lib"
			],
			"$lib/*": [
				"../_/lib/*"
			]
		}
	}
}
